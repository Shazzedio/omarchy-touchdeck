#!/usr/bin/env bash
# touchdeck-launch: move focus, and optionally launch an app, for the deck.
#
#   touchdeck-launch [--monitor NAME | --workspace ID] [--desktop ID | --command CMD]
#   touchdeck-launch --restore-focus NAME --deck NAME
#
# Focus goes through `hyprctl eval` together with a cursor move back to where
# the pointer already was. Hyprland's focus dispatcher warps the cursor to the
# middle of the newly focused monitor and ignores `warp = false`; doing both
# in one eval lands in a single compositor tick, so the pointer never visibly
# moves (DECISIONS.md G-12).
#
# Apps launch the way Omarchy's own launcher does (shell/services/AppLibrary.qml):
# `uwsm-app -- gtk-launch <id>.desktop`, so they get their own systemd scope and
# outlive a shell restart. Custom commands go through the same wrapper via
# `sh -c` (DESIGN.md D8, 11). Focus is moved first and the launch follows in the
# same script, so the app can't start before focus has moved.
#
# --restore-focus NAME moves focus back to NAME, but only if focus is still on
# the deck's output and the pointer isn't there: then focus arrived by touch,
# not because someone is using a mouse on the deck (DESIGN.md 5.6).
#
# --dry-run prints each command instead of running it. For tests,
# TOUCHDECK_CURSOR ("x, y") and TOUCHDECK_MONITORS_JSON (hyprctl -j monitors)
# replace the live queries.
set -uo pipefail

monitor=""
workspace=""
desktop=""
command=""
restore=""
deck=""
dry=0

fail() { printf 'touchdeck-launch: %s\n' "$1" >&2; exit 2; }

while (($#)); do
  case "$1" in
    --monitor) monitor="${2:-}"; shift 2 || shift ;;
    --workspace) workspace="${2:-}"; shift 2 || shift ;;
    --desktop) desktop="${2:-}"; shift 2 || shift ;;
    --command) command="${2:-}"; shift 2 || shift ;;
    --restore-focus) restore="${2:-}"; shift 2 || shift ;;
    --deck) deck="${2:-}"; shift 2 || shift ;;
    --dry-run) dry=1; shift ;;
    *) fail "unknown argument: $1" ;;
  esac
done

# Names are interpolated into Lua, so they are checked, not escaped.
name_ok() { [[ $1 =~ ^[A-Za-z0-9_.:-]+$ ]]; }
[[ -z $monitor || $(name_ok "$monitor"; echo $?) == 0 ]] || fail "bad monitor name: $monitor"
[[ -z $restore || $(name_ok "$restore"; echo $?) == 0 ]] || fail "bad monitor name: $restore"
[[ -z $deck || $(name_ok "$deck"; echo $?) == 0 ]] || fail "bad monitor name: $deck"
[[ -z $workspace || $workspace =~ ^[A-Za-z0-9_-]+$ ]] || fail "bad workspace: $workspace"
[[ -z $desktop || $desktop =~ ^[^/[:space:]]+$ ]] || fail "bad desktop id: $desktop"
[[ -n $monitor && -n $workspace ]] && fail "--monitor and --workspace are exclusive"

run() {
  if ((dry)); then printf 'run:'; printf ' %s' "$@"; printf '\n'; else "$@" >/dev/null 2>&1; fi
}

monitors_json() { printf '%s' "${TOUCHDECK_MONITORS_JSON:-$(hyprctl -j monitors 2>/dev/null)}"; }

# Sets CX and CY to the pointer's position. Fails if it can't be read.
cursor() {
  local pos="${TOUCHDECK_CURSOR:-$(hyprctl cursorpos 2>/dev/null)}"
  CX=${pos%%,*}
  CY=${pos##*,}
  CX=${CX// /}
  CY=${CY// /}
  [[ $CX =~ ^-?[0-9]+$ && $CY =~ ^-?[0-9]+$ ]]
}

# focus_keeping_cursor '<lua target>', e.g. 'monitor = "DP-1"'
focus_keeping_cursor() {
  if cursor; then
    run hyprctl eval "hl.dispatch(hl.dsp.focus({ $1 })); hl.dispatch(hl.dsp.cursor.move({ x = $CX, y = $CY }))"
  else
    run hyprctl dispatch "hl.dsp.focus({ $1 })"
  fi
}

focused_monitor() { monitors_json | jq -r '.[] | select(.focused) | .name' 2>/dev/null | head -1; }

# Whether the pointer is inside monitor NAME (logical coordinates).
pointer_on() {
  cursor || return 1
  monitors_json | jq -e --arg n "$1" --argjson x "$CX" --argjson y "$CY" '
    .[] | select(.name == $n)
    | (if (.transform % 2) == 1 then [.height, .width] else [.width, .height] end) as $size
    | select($x >= .x and $x < .x + $size[0] / .scale and $y >= .y and $y < .y + $size[1] / .scale)
  ' >/dev/null 2>&1
}

if [[ -n $restore ]]; then
  [[ -n $deck ]] || fail "--restore-focus needs --deck"
  if [[ $(focused_monitor) != "$deck" ]]; then
    ((dry)) && echo "skip: focus is not on the deck"
    exit 0
  fi
  if pointer_on "$deck"; then
    ((dry)) && echo "skip: the pointer is on the deck"
    exit 0
  fi
  focus_keeping_cursor "monitor = \"$restore\""
  exit 0
fi

if [[ -n $monitor ]]; then
  focus_keeping_cursor "monitor = \"$monitor\""
elif [[ -n $workspace ]]; then
  focus_keeping_cursor "workspace = \"$workspace\""
fi

if [[ -n $desktop ]]; then
  desktop=${desktop%.desktop}
  if ((dry)); then echo "launch: uwsm-app -- gtk-launch $desktop.desktop"; exit 0; fi
  exec uwsm-app -- gtk-launch "$desktop.desktop"
elif [[ -n $command ]]; then
  if ((dry)); then echo "launch: uwsm-app -- sh -c $command"; exit 0; fi
  exec uwsm-app -- sh -c "$command"
fi
